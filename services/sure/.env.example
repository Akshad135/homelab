# Required Self-Hosting Configuration
SELF_HOSTED=true
ONBOARDING_STATE=open
SECRET_KEY_BASE=generate-with-openssl-rand-hex-64

# Database Configuration
POSTGRES_USER=sure_user
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-16
POSTGRES_DB=sure_production
DB_HOST=sure-db
DB_PORT=5432

# Cache / Redis Configuration
REDIS_URL=redis://sure-redis:6379/1

# SSL & Reverse Proxy Settings
RAILS_ASSUME_SSL=true
RAILS_FORCE_SSL=false

# Passkey / WebAuthn Settings
WEBAUTHN_RP_ID=duckdns.org
WEBAUTHN_ALLOWED_ORIGINS=https://akshad.duckdns.org:8006
