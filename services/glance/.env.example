# Glance Environment Variables
# Copy this file to .env and fill in the values

# Air Quality (WAQI)
WAQI_API_TOKEN=your_waqi_token_here

# Tailscale Devices
TAILSCALE_API_KEY=your_tailscale_api_key_here

# AdGuard Stats
ADGUARD_URL=http://adguardhome
ADGUARD_USERNAME=your_adguard_username
ADGUARD_PASSWORD=your_adguard_password

# Discord Status (Lanyard)
DISCORD_USER_ID=your_discord_id_here

# AniList Stats
ANILIST_USERNAME=your_anilist_username
